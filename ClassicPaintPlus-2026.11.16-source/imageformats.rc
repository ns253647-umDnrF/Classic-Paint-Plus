LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_DDS_OPTIONS DIALOGEX 0, 0, 285, 143
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DDS options"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "", IDC_FORMAT_GROUP, 10, 8, 265, 84
    COMBOBOX IDC_DDS_COMPRESSION, 20, 24, 245, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_FORMAT_DESCRIPTION, 20, 45, 245, 40
    CONTROL "", IDC_FORMAT_DEFAULTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 100, 265, 13
    DEFPUSHBUTTON "OK", IDOK, 58, 121, 67, 17
    PUSHBUTTON "", IDCANCEL, 133, 121, 67, 17
    PUSHBUTTON "", IDC_FORMAT_RESET, 208, 121, 67, 17
END
IDD_PNG_OPTIONS DIALOGEX 0, 0, 285, 154
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PNG options"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "", IDC_FORMAT_GROUP, 10, 8, 265, 96
    CONTROL "", IDC_PNG_INTERLACE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 26, 244, 14
    CONTROL "", IDC_PNG_OPTIMIZE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 49, 244, 14
    LTEXT "", IDC_FORMAT_DESCRIPTION, 20, 70, 244, 27
    CONTROL "", IDC_FORMAT_DEFAULTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 111, 265, 13
    DEFPUSHBUTTON "OK", IDOK, 58, 132, 67, 17
    PUSHBUTTON "", IDCANCEL, 133, 132, 67, 17
    PUSHBUTTON "", IDC_FORMAT_RESET, 208, 132, 67, 17
END
IDD_WEBP_OPTIONS DIALOGEX 0, 0, 285, 145
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WebP options"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_WEBP_LOSSLESS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 12, 265, 14
    GROUPBOX "", IDC_FORMAT_GROUP, 10, 34, 265, 57
    CONTROL "", IDC_FORMAT_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 20, 49, 198, 22
    EDITTEXT IDC_FORMAT_QUALITY, 230, 51, 35, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "", IDC_FORMAT_DEFAULTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 101, 265, 13
    DEFPUSHBUTTON "OK", IDOK, 58, 123, 67, 17
    PUSHBUTTON "", IDCANCEL, 133, 123, 67, 17
    PUSHBUTTON "", IDC_FORMAT_RESET, 208, 123, 67, 17
END
IDD_ICO_OPTIONS DIALOGEX 0, 0, 285, 133
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Icon options"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_FORMAT_LABEL, 10, 12, 110, 13
    COMBOBOX IDC_ICO_SIZE, 125, 10, 150, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_ICO_KEEP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 38, 265, 14
    LTEXT "", IDC_FORMAT_DESCRIPTION, 10, 62, 265, 36
    DEFPUSHBUTTON "OK", IDOK, 133, 110, 67, 17
    PUSHBUTTON "", IDCANCEL, 208, 110, 67, 17
END
IDD_ICO_SELECT DIALOGEX 0, 0, 285, 142
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Icon image"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_FORMAT_LABEL, 10, 12, 265, 13
    COMBOBOX IDC_ICO_SIZE, 10, 30, 158, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_ICO_PREVIEW, "Static", SS_OWNERDRAW, 183, 10, 92, 96
    DEFPUSHBUTTON "OK", IDOK, 133, 119, 67, 17
    PUSHBUTTON "", IDCANCEL, 208, 119, 67, 17
END
