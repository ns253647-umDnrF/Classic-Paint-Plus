LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_JPEG_SAVE DIALOGEX 0, 0, 300, 32
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_JPEG_PRESERVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 5, 205, 14
    CONTROL "", IDC_PAINT_DATA, "Button", BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP, 8, 2, 205, 27
    PUSHBUTTON "", IDC_JPEG_OPTIONS, 222, 3, 70, 17
END

IDD_JPEG_OPTIONS DIALOGEX 0, 0, 340, 299
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "JPEG options"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "", IDC_JPEG_QUALITY_GROUP, 10, 8, 320, 65
    LTEXT "", IDC_JPEG_SMALL, 19, 29, 75, 26
    CONTROL "", IDC_JPEG_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 96, 23, 146, 22
    RTEXT "", IDC_JPEG_BEST, 246, 29, 75, 26
    EDITTEXT IDC_JPEG_QUALITY, 149, 50, 30, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "", IDC_JPEG_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS, 179, 50, 10, 12
    GROUPBOX "", IDC_JPEG_ENCODING, 10, 80, 153, 65
    CONTROL "", IDC_JPEG_PROGRESSIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 19, 99, 136, 14
    CONTROL "", IDC_JPEG_OPTIMIZE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 19, 122, 136, 14
    GROUPBOX "", IDC_JPEG_SAMPLING, 171, 80, 159, 65
    CONTROL "", IDC_JPEG_HORIZONTAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 180, 99, 140, 14
    CONTROL "", IDC_JPEG_VERTICAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 180, 122, 140, 14
    GROUPBOX "", IDC_JPEG_THUMBS, 10, 153, 320, 104
    CONTROL "", IDC_JPEG_EXISTING, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 19, 170, 300, 14
    CONTROL "", IDC_JPEG_ALWAYS, "Button", BS_AUTORADIOBUTTON, 19, 191, 300, 14
    CONTROL "", IDC_JPEG_NEVER, "Button", BS_AUTORADIOBUTTON, 19, 212, 300, 14
    CONTROL "", IDC_JPEG_DCF, "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 19, 236, 300, 14
    CONTROL "", IDC_JPEG_DEFAULTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 262, 320, 12
    DEFPUSHBUTTON "OK", IDOK, 102, 279, 70, 17
    PUSHBUTTON "", IDCANCEL, 181, 279, 70, 17
    PUSHBUTTON "", IDC_JPEG_RESET, 260, 279, 70, 17
END
