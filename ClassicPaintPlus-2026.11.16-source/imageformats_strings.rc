    IDS_FORMAT_BASE+5 "Lossless compression"
    IDS_FORMAT_BASE+6 "Icon options"
    IDS_FORMAT_BASE+7 "Image size"
    IDS_FORMAT_BASE+8 "Keep other images in this icon"
    IDS_FORMAT_BASE+9 "Current size"
    IDS_FORMAT_BASE+10 "ICO supports up to 256 × 256 pixels. Resizing keeps proportions and adds transparent padding."
    IDS_FORMAT_BASE+11 "Choose icon image"
    IDS_FORMAT_BASE+12 "Image to edit"
    IDS_FORMAT_BASE+13 "The first animation frame is open. Editing and saving produce a still image; use Save As to keep the animation."
    IDS_FORMAT_BASE+14 "24-bit bitmap"
    IDS_FORMAT_BASE+15 "Monochrome bitmap"
    IDS_FORMAT_BASE+16 "16-color bitmap"
    IDS_FORMAT_BASE+17 "256-color bitmap"
    IDS_FORMAT_BASE+18 "Icon"
END

