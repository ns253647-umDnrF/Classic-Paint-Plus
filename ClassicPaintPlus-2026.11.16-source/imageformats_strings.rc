// Image format strings, UTF-8.
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_FORMAT_BASE+0 "PNG options"
    IDS_FORMAT_BASE+1 "Interlaced (Adam7)"
    IDS_FORMAT_BASE+2 "Optimize file size"
    IDS_FORMAT_BASE+3 "Reduces file size by merging similar colors. The working canvas stays full color."
