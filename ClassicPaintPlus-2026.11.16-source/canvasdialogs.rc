LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_CROP_EDGES DIALOGEX 0, 0, 480, 340
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Crop edges"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_EDGE_LEFT_LABEL, 10, 12, 70, 12
    EDITTEXT IDC_EDGE_LEFT, 83, 9, 35, 12, ES_AUTOHSCROLL
    CONTROL "", IDC_SPIN_LEFT, "msctls_updown32", UDS_ARROWKEYS, 118, 9, 10, 12
    LTEXT "", IDC_EDGE_RIGHT_LABEL, 335, 12, 70, 12
    EDITTEXT IDC_EDGE_RIGHT, 407, 9, 35, 12, ES_AUTOHSCROLL
    CONTROL "", IDC_SPIN_RIGHT, "msctls_updown32", UDS_ARROWKEYS, 442, 9, 10, 12
    LTEXT "", IDC_EDGE_TOP_LABEL, 10, 36, 70, 12
    EDITTEXT IDC_EDGE_TOP, 10, 51, 35, 12, ES_AUTOHSCROLL
    CONTROL "", IDC_SPIN_TOP, "msctls_updown32", UDS_ARROWKEYS, 45, 51, 10, 12
    LTEXT "", IDC_EDGE_BOTTOM_LABEL, 10, 234, 70, 12
    EDITTEXT IDC_EDGE_BOTTOM, 10, 249, 35, 12, ES_AUTOHSCROLL
    CONTROL "", IDC_SPIN_BOTTOM, "msctls_updown32", UDS_ARROWKEYS, 45, 249, 10, 12
    CONTROL "", IDC_CANVAS_PREVIEW, "Static", SS_OWNERDRAW, 85, 35, 377, 229
    LTEXT "", IDC_FILL_LABEL, 10, 274, 245, 12
    COMBOBOX IDC_CANVAS_FILL, 10, 290, 215, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "", IDC_FILL_SWATCH, 232, 290, 23, 16, BS_OWNERDRAW
    LTEXT "", IDC_CANVAS_RESULT, 10, 316, 330, 16
    DEFPUSHBUTTON "OK", IDOK, 352, 313, 52, 17
    PUSHBUTTON "Cancel", IDCANCEL, 410, 313, 52, 17
END

IDD_CANVAS_SIZE DIALOGEX 0, 0, 330, 292
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Canvas size"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "", IDC_CURRENT_GROUP, 10, 8, 245, 56
    LTEXT "", IDC_CURRENT_SIZE, 22, 25, 222, 28
    GROUPBOX "", IDC_NEW_GROUP, 10, 72, 245, 145
    LTEXT "", IDC_WIDTH_LABEL, 20, 91, 85, 12
    EDITTEXT IDC_NEW_WIDTH, 110, 88, 35, 12, ES_AUTOHSCROLL
    LTEXT "", IDC_WIDTH_UNITS, 153, 91, 90, 12
    LTEXT "", IDC_HEIGHT_LABEL, 20, 115, 85, 12
    EDITTEXT IDC_NEW_HEIGHT, 110, 112, 35, 12, ES_AUTOHSCROLL
    LTEXT "", IDC_HEIGHT_UNITS, 153, 115, 90, 12
    CONTROL "", IDC_RELATIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 135, 134, 14
    LTEXT "", IDC_ANCHOR_LABEL, 20, 160, 85, 14
    PUSHBUTTON "", IDC_ANCHOR_FIRST, 110, 157, 18, 17, BS_OWNERDRAW
    PUSHBUTTON "", IDC_ANCHOR_FIRST+1, 129, 157, 18, 17, BS_OWNERDRAW
    PUSHBUTTON "", IDC_ANCHOR_FIRST+2, 148, 157, 18, 17, BS_OWNERDRAW
    PUSHBUTTON "", IDC_ANCHOR_FIRST+3, 110, 175, 18, 17, BS_OWNERDRAW
    PUSHBUTTON "", IDC_ANCHOR_FIRST+4, 129, 175, 18, 17, BS_OWNERDRAW
    PUSHBUTTON "", IDC_ANCHOR_FIRST+5, 148, 175, 18, 17, BS_OWNERDRAW
    PUSHBUTTON "", IDC_ANCHOR_FIRST+6, 110, 193, 18, 17, BS_OWNERDRAW
    PUSHBUTTON "", IDC_ANCHOR_FIRST+7, 129, 193, 18, 17, BS_OWNERDRAW
    PUSHBUTTON "", IDC_ANCHOR_FIRST+8, 148, 193, 18, 17, BS_OWNERDRAW
    LTEXT "", IDC_FILL_LABEL, 10, 227, 245, 12
    COMBOBOX IDC_CANVAS_FILL, 10, 243, 215, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "", IDC_FILL_SWATCH, 232, 243, 23, 16, BS_OWNERDRAW
    LTEXT "", IDC_CANVAS_RESULT, 10, 267, 245, 20
    DEFPUSHBUTTON "OK", IDOK, 267, 12, 53, 17
    PUSHBUTTON "Cancel", IDCANCEL, 267, 36, 53, 17
END
