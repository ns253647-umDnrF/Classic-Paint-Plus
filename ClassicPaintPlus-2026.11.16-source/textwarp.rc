#include "textwarp_resource.h"
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_TEXT_WARP DIALOGEX 0, 0, 330, 190
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Warp text"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "", -1, 8, 7, 245, 175
    LTEXT "", 7500, 18, 19, 40, 12
    COMBOBOX IDC_WARP_STYLE, 61, 16, 180, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_WARP_HORIZONTAL, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 32, 42, 105, 12
    CONTROL "", IDC_WARP_VERTICAL, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 145, 42, 98, 12
    LTEXT "", 7503, 20, 69, 165, 12
    EDITTEXT IDC_WARP_BEND, 191, 66, 49, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_WARP_SLIDER_FIRST, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 18, 84, 224, 20
    LTEXT "", 7504, 20, 109, 165, 12
    EDITTEXT IDC_WARP_HDIST, 191, 106, 49, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_WARP_SLIDER_FIRST+1, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 18, 124, 224, 20
    LTEXT "", 7505, 20, 149, 165, 12
    EDITTEXT IDC_WARP_VDIST, 191, 146, 49, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_WARP_SLIDER_FIRST+2, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 18, 164, 224, 16
    DEFPUSHBUTTON "OK", IDOK, 263, 16, 57, 17
    PUSHBUTTON "Cancel", IDCANCEL, 263, 40, 57, 17
END
